{
  "name": "painel-de-scripts",
  "version": "6.5.7",
  "private": true,
  "main": "dist/painel.js",
  "bin": "dist/painel.js",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "build": "esbuild src/app.js --bundle --platform=node --target=node20 --outfile=dist/painel.js --loader:.txt=text --loader:.html=text --loader:.ico=binary --loader:.png=binary --external:bufferutil --external:utf-8-validate",
    "empacotar": "pkg dist/painel.js -t node22-win-x64 --no-bytecode --public --public-packages \"*\" -o out/PainelDeScripts.exe && node patch-gui.js out/PainelDeScripts.exe"
  },
  "dependencies": {
    "puppeteer-core": "^23.11.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.25.0",
    "codemirror": "^5.65.16",
    "esbuild": "^0.24.0",
    "eslint-scope": "^9.1.2",
    "espree": "^11.2.0",
    "globals": "^17.13.0"
  }
}
